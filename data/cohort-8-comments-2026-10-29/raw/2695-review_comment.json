    "diff_hunk": "@@ -0,0 +1,23 @@\n+class Solution:\n+\n+    def __init__(self):\n+        self.memo = dict()\n+\n+    def climbStairs(self, n: int) -> int:\n+        \n+        # 공간복잡도 : n의 개수 만큼 memo가 할당되므로 o(n)\n+        # 시간복잡도 : 각 칸에 대해서 계산이 1번씩만 되므로 o(n)\n+\n+        # base \n+        if n <= 2 : \n+            return n\n+        \n+        # 이미 계산 한 값이라면 반환\n+        if n in self.memo:\n+            return self.memo[n]",
