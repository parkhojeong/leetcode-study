    "diff_hunk": "@@ -0,0 +1,31 @@\n+# https://leetcode.com/problems/house-robber/description/\n+\n+# 훔칠 수 있는 최대 금액을 구한다\n+# 단 연속된 집을 훔치면 경찰에 체포됨\n+\n+# 앞집, 앞앞집의 최대 수익을 아래 변수들에 기록한다\n+# prev2, prev1, curr\n+\n+# Time: O(N)\n+# Space: O(1)\n+class Solution:\n+    def rob(self, nums: List[int]) -> int:\n+        prev2 = 0 # 앞앞집 최대 수익\n+        prev1 = 0 # 앞집 최대 수익\n+        \n+        for num in nums:\n+            # 현재 최대 수익은\n+            # 1) 앞집 수익\n+            # 2) 앞앞집 수익 + 현재수익\n+            curr = max(prev1, prev2 + num)\n+\n+            # 다음 턴을 위해 값을 슬라이딩(?)\n+            # prev3 prev2 prev1 curr\n+            #         a     b    c\n+            #  a      b     c \n+            prev2 = prev1\n+            prev1 = curr",
