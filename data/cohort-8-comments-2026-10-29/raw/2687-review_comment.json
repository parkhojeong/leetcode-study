    "diff_hunk": "@@ -0,0 +1,51 @@\n+class Solution:\n+    def threeSum(self, nums: List[int]) -> List[List[int]]:\n+        res = []\n+        nums.sort()\n+\n+        for i, a in enumerate(nums):\n+            if a > 0:\n+                break\n+            if i > 0 and a == nums[i-1]:\n+                continue\n+            \n+            l, r = i+1, len(nums) - 1\n+            while l < r:\n+                total = a + nums[l] + nums[r]\n+                if total > 0:\n+                    r -= 1\n+                elif total < 0:\n+                    l += 1\n+                else:\n+                    res.append([a, nums[l], nums[r]])\n+                    l += 1\n+                    r -= 1\n+                    while nums[l] == nums[l - 1] and l < r:\n+                        l += 1\n+        return res",
