    "diff_hunk": "@@ -0,0 +1,17 @@\n+class Solution {\n+    public int maxProfit(int[] prices) {\n+        int result = 0;\n+        // prices = [7,1,5,3,6,4]\n+        int lt = 0;\n+        for ( int i = 1 ; i < prices.length; i ++){\n+            if ( prices[i] < prices[lt] ){\n+                lt = i;\n+            }\n+            else{\n+                result = Math.max(result, prices[i] - prices[lt]);\n+            }\n+        }\n+\n+        return result;",
