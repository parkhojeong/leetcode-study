    "diff_hunk": "@@ -0,0 +1,11 @@\n+class Solution:\n+    # Time Complexity: O(nlogn), n: len(nums)\n+    # Space Complexity: O(1)\n+    def containsDuplicate(self, nums: List[int]) -> bool:\n+        nums.sort()  # O(nlogn)\n+\n+        for i in range(len(nums)):\n+            if i > 0 and nums[i] == nums[i - 1]:\n+                return True\n+\n+        return False",
