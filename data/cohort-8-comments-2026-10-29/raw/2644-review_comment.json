    "diff_hunk": "@@ -0,0 +1,20 @@\n+# Time: O(N)\n+# Space: O(N)\n+class Solution:\n+    def rob(self, nums: List[int]) -> int:\n+        if len(nums) == 1:\n+            return nums[0]\n+\n+        len_nums = len(nums)\n+        cum_sum = [0 for i in range(len(nums))]\n+\n+        for i in range(len(nums)):\n+            if i - 3 >= 0:\n+                val1 = cum_sum[i-2] + nums[i]\n+                val2 = cum_sum[i-3] + nums[i]\n+                cum_sum[i] = max(val1, val2)\n+            elif i - 2 >= 0:\n+                cum_sum[i] = cum_sum[i-2] + nums[i]\n+            else:\n+                cum_sum[i] = nums[i]\n+        return max(cum_sum)",
