    "diff_hunk": "@@ -0,0 +1,24 @@\n+# Time: O(N)\n+# Space: O(N)\n+class Solution:\n+    def longestConsecutive(self, nums: List[int]) -> int:\n+        set_nums = set(nums)\n+        longest = 0\n+\n+        while len(set_nums) > 0 :\n+            origin_val = set_nums.pop()\n+            local_len = 1\n+\n+            val = origin_val - 1\n+            while val in set_nums:\n+                local_len += 1\n+                set_nums.remove(val)\n+                val -= 1\n+\n+            val = origin_val + 1\n+            while val in set_nums:\n+                local_len += 1\n+                set_nums.remove(val)\n+                val += 1\n+            longest = max(longest, local_len)",
