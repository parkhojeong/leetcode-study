    "diff_hunk": "@@ -0,0 +1,19 @@\n+class Solution {\n+    public int hammingWeight(int n) {\n+\n+        if (n == 1) {\n+            return 1;\n+        }\n+\n+        int curr = n, result = 1;\n+        while (curr > 1) {\n+            if (curr % 2 == 1) {\n+                result++;\n+            }\n+            curr = curr / 2;\n+        }\n+\n+        return result;\n+    }",
