    "diff_hunk": "@@ -0,0 +1,33 @@\n+\"\"\"\n+시간 복잡도: O(N)\n+공간 복잡도: O(N)\n+\n+이 코드는 이진 탐색 트리(BST)에서 k번째로 작은 값을 찾는 함수입니다.\n+중위 순회를 통해 노드를 오름차순으로 방문하여,\n+k번째 값을 찾는 방식으로 동작합니다.\n+\"\"\"\n+class Solution:\n+    def kthSmallest(self, root: Optional[TreeNode], k: int) -> int:\n+        stack = []\n+        index = 1\n+\n+        while root:\n+            stack.append(root)\n+            root = root.left\n+\n+        while stack:\n+            node = stack.pop()\n+\n+            if index == k:\n+                return node.val\n+            index += 1\n+\n+            if not node.right:\n+                continue",
