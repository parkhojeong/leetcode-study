    "diff_hunk": "@@ -0,0 +1,18 @@\n+class Solution {\n+    public int numDecodings(String s) {\n+        int n = s.length();\n+        int[] dp = new int[n + 1];\n+        dp[0] = 1;\n+        dp[1] = s.charAt(0) == '0' ? 0 : 1;\n+        for(int i = 2 ; i <= n ; i++){\n+            if(s.charAt(i - 1) != '0'){\n+                dp[i] += dp[i - 1];\n+            }\n+            int twoDigit = (s.charAt(i - 2) - '0') * 10 + (s.charAt(i - 1) - '0');\n+            if(twoDigit >= 10 && twoDigit <= 26){\n+                dp[i] += dp[i - 2];\n+            }",
