    "diff_hunk": "@@ -0,0 +1,26 @@\n+\n+/*\n+f(45) = f(44) + f(43)\n+f(44) = f(43) + f(42)\n+.\n+.\n+.\n+f(3) = f(2) + f(1)\n+f(2) = 2\n+f(1) = 1\n+*/\n+class Solution {\n+    public int climbStairs(int n) {\n+        if (n <= 2) return n;\n+\n+        int prev = 1;\n+        int result = 2;\n+        int temp = 0;\n+        for (int i = 2; i < n ; i++) {\n+            temp = result;\n+            result += prev;\n+            prev = temp;\n+        }     \n+        return result;",
