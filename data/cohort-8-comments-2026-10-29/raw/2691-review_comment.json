    "diff_hunk": "@@ -0,0 +1,15 @@\n+class Solution {\n+    public int climbStairs(int n) {\n+        int[] dp = new int[n + 1];\n+        if (n <= 3) return n;\n+        dp[1] = 1;\n+        dp[2] = 2;\n+        dp[3] = 3;\n+\n+        for (int i = 4; i <= n; i++) {\n+            dp[i] = dp[i - 1] + dp[i - 2];\n+        }\n+\n+        return dp[n];\n+    }\n+}",
