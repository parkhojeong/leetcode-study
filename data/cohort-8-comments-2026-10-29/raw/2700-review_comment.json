    "body": "reduce 로직에서 key가 없는 경우 `undefined + 1 || 1` -> `NaN || 1` -> `1` 의 순서로 평가되는데 `(undifiend ?? 0) + 1` 과 같이 undefined에 대한 fallback을 사용해보셔도 좋을 거 같습니다!\r\n\r\n```suggestion\r\nvar isAnagram = function (s, t) {\r\n  if (s.length !== t.length) return false;\r\n  const sCount = [...s].reduce((acc, cur) => {\r\n    acc[cur] = (acc[cur] ?? 0) + 1;\r\n    return acc;\r\n  }, {});\r\n  const tCount = [...t].reduce((acc, cur) => {\r\n    acc[cur] = (acc[cur] ?? 0) + 1 ;\r\n    return acc;\r\n  }, {});\r\n  return Object.keys(sCount).every(key => sCount[key] === tCount[key]);\r\n};\r\n```",
