    "diff_hunk": "@@ -0,0 +1,44 @@\n+import sys\n+from typing import List\n+\n+class Solution:\n+    def maxSubArray(self, nums: List[int]) -> int:\n+        max_val = -sys.maxsize\n+\n+        for num in nums:\n+            max_val = max(max_val, num)\n+\n+        nums = [x for x in nums if x != 0]\n+        if not nums:\n+            return max_val\n+\n+        arr = []\n+        arr.append(nums[0])\n+        for i in range(1, len(nums)):\n+            if nums[i] * nums[i - 1] > 0:\n+                arr[-1] += nums[i]\n+            else:\n+                arr.append(nums[i])\n+\n+        for num in arr:\n+            max_val = max(max_val, num)\n+\n+        while len(arr) >= 2:\n+            if arr[0] < 0:\n+                arr = arr[1:]\n+            if arr[-1] < 0:\n+                arr = arr[:-1]\n+\n+            max_val = max(max_val, arr[0])\n+            if len(arr) >= 2:\n+                arr[1] = arr[0] + arr[1]\n+                arr = arr[1:]\n+\n+            max_val = max(max_val, arr[-1])\n+            if len(arr) >= 2:\n+                arr[-2] = arr[-1] + arr[-2]\n+                arr = arr[:-1]\n+\n+        max_val = max(max_val, arr[0])",
