    "diff_hunk": "@@ -0,0 +1,7 @@\n+from collections import Counter\n+\n+class Solution:\n+    # Time Complexity: O(n), n: max(len(s), len(t))\n+    # Space Complexity: O(k), k: number of letters\n+    def isAnagram(self, s: str, t: str) -> bool:\n+        return Counter(s) == Counter(t)",
