    "diff_hunk": "@@ -38,3 +38,38 @@ def go_right(self, cur:TreeNode, mm:int, MM:int):\n         if cur.right:\n             self.go_right(cur.right, cur.val, MM)\n \n+\n+\n+\n+# ---------\n+\n+\n+# Definition for a binary tree node.\n+\n+# TC: O(n)\n+# SC: O(h)\n+\n+# class TreeNode:\n+#     def __init__(self, val=0, left=None, right=None):\n+#         self.val = val\n+#         self.left = left\n+#         self.right = right\n+class Solution:\n+    def isValidBST(self, root: Optional[TreeNode]) -> bool:\n+        \n+        def isValid(mm, MM, cur: TreeNode) -> bool:\n+            \n+\n+            if cur == None:\n+                return True\n+            \n+            if mm != None and cur.val <= mm:\n+                return False\n+             \n+            if MM != None and cur.val >= MM:\n+                return False\n+            \n+            return isValid(mm, cur.val, cur.left) and isValid(cur.val, MM, cur.right)\n+        \n+        return isValid(None, None ,root)",
