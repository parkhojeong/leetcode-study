    "diff_hunk": "@@ -30,3 +30,35 @@ def threeSum(self, nums: list[int]) -> list[list[int]]:\n                     left = left + 1\n                     right = right - 1\n         return answer\n+\n+\n+# TC : O(n^2)\n+# SC : O(n)\n+\n+class Solution:\n+    def threeSum(self, nums: list[int]) -> list[list[int]]:\n+        \n+        nums.sort()\n+\n+        answer_map = {}\n+        answer = []\n+        \n+        for i in range(len(nums)):\n+            target = -1 * nums[i]\n+\n+            left = i + 1\n+            right = len(nums) - 1\n+\n+            while left < right:\n+                if nums[left] + nums[right] == target:\n+                    candidate = (target * -1, nums[left], nums[right])\n+                    if candidate not in answer_map:\n+                        answer_map[candidate] = True\n+                        answer.append([target * -1, nums[left], nums[right]])",
