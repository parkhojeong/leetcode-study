    "diff_hunk": "@@ -0,0 +1,20 @@\n+import java.util.*;\n+\n+// TC: O(n)\n+// SC: O(n)\n+class Solution {\n+    public int maxSubArray(int[] nums) {\n+        int n = nums.length;\n+        int[] dp = new int[n];\n+\n+        dp[n - 1] = nums[n - 1];\n+        int answer = dp[n - 1];\n+\n+        for (int i = n - 2; i >= 0; i--) {\n+            dp[i] = Math.max(dp[i + 1] + nums[i], nums[i]);\n+            answer = Math.max(answer, dp[i]);\n+        }",
